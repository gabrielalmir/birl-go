OH O HOMEM AI PO MONSTRO TREINO_PESADO(MONSTRO id)
    CE QUER VER ESSA PORRA?("INICIANDO TREINO CONCORRENTE");
    AJUDA O MALUCO TA DOENTE DESCANSO(500);
    CE QUER VER ESSA PORRA?("FINALIZANDO TREINO");
BIRL

HORA DO SHOW
    BORA DIVIDIR O PESO AJUDA O MALUCO TA DOENTE TREINO_PESADO(1);
    CE QUER VER ESSA PORRA?("MAIN CONTINUA RODANDO...");
    AJUDA O MALUCO TA DOENTE DESCANSO(1000);
BIRL
